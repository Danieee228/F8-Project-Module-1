<!-- Blog 1 -->
<div class="col">
  <div class="blog-card">
    <!-- Blog Image -->
    <a
      href="#!"
      class="blog-card__media-link"
    >
      <img
        src="/asset/img/index/img-blog-1.png"
        alt="Blog-1"
        class="blog-card__img"
      />
    </a>
    <!-- Blog Media -->
    <div class="blog-card__media">
      <img
        src="/asset/img/index/img-blog-avatar-1.png"
        alt="Mitchell Starc"
        class="blog-card__avatar"
      />
      <!-- Blog Info -->
      <div class="blog-card__info">
        <span class="blog-card__author">Mitchell Starc</span>
        <span class="blog-card__position">Attorney at Law</span>
      </div>
    </div>
    <!-- Blog Title -->
    <a
      class="blog-card__title"
      href="#!"
    >
      5 Key Rules of Law in Our Society Must Know in 2022
    </a>
    <!-- Blog Link -->
    <a
      href="#!"
      class="blog-card__link"
      >Learn More</a
    >
  </div>
</div>
